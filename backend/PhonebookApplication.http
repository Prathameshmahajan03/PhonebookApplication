@PhonebookApplication_HostAddress = https://localhost:7233

### List contacts (read-only)
GET {{PhonebookApplication_HostAddress}}/api/contacts?pageNumber=1&pageSize=10&searchTerm=
Accept: application/json

### Get a contact by ID (read-only; replace 1 with an existing ID)
GET {{PhonebookApplication_HostAddress}}/api/contacts/1
Accept: application/json

### Create a contact (modifies the configured database)
# POST {{PhonebookApplication_HostAddress}}/api/contacts
# Content-Type: application/json
#
# {
#   "name": "Example Contact",
#   "phoneNumber": "5551234567",
#   "email": "example@example.com",
#   "address": "Example address"
# }

### Update a contact (modifies the configured database; replace 1 with an existing ID)
# PUT {{PhonebookApplication_HostAddress}}/api/contacts/1
# Content-Type: application/json
#
# {
#   "name": "Updated Contact",
#   "phoneNumber": "5551234567",
#   "email": "updated@example.com",
#   "address": "Updated address"
# }

### Delete a contact (modifies the configured database; replace 1 with an existing ID)
# DELETE {{PhonebookApplication_HostAddress}}/api/contacts/1
